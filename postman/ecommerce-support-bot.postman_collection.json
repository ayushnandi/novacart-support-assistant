{
  "info": {
    "name": "NovaCart Support Bot",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "session_id", "value": "" },
    { "key": "message_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Create Session",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/session",
        "body": { "mode": "raw", "raw": "{}" }
      }
    },
    {
      "name": "Chat (SSE stream)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/chat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"message\": \"How do I track my order?\",\n  \"user_id\": null\n}"
        }
      }
    },
    {
      "name": "Submit Feedback",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/feedback",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message_id\": \"{{message_id}}\",\n  \"rating\": \"up\",\n  \"comment\": null\n}"
        }
      }
    },
    {
      "name": "Get Logs",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/logs?session_id={{session_id}}"
      }
    },
    {
      "name": "Get Mock Profile",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/profile/ayush"
      }
    }
  ]
}
